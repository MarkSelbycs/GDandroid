            <ProgressBar android:layout_width="@dimen/loadingIconSize" android:layout_height="@dimen/loadingIconSize" android:layout_centerVertical="true" android:indeterminateTint="#fff" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0">
