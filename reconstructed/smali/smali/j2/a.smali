.class public Lj2/a;
.super Ll2/a;
.source "ApacheCommonsLog4JLog.java"


# direct methods
.method public constructor <init>(Ljava/lang/Class;)V
    .locals 0
    .annotation system Ldalvik/annotation/Signature;
        value = {
            "(",
            "Ljava/lang/Class<",
            "*>;)V"
        }
    .end annotation

    invoke-direct {p0, p1}, Ll2/a;-><init>(Ljava/lang/Class;)V

    return-void
.end method
